# PostgreSQL with pgvector. For Neon, prefer its pooled connection URL.
# Set DATABASE_URL_POOLED to the Neon pooled URL; if FRIIS_DATABASE_URL is set,
# it takes precedence over DATABASE_URL_POOLED and DATABASE_URL.
# Keep credentials in the local, git-ignored .env file.
# DATABASE_URL_POOLED=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=postgresql://user:password@your-endpoint.region.aws.neon.tech/dbname?sslmode=require
DB_USER=postgres
DB_PASSWORD=replace-with-local-secret
DB_HOST=localhost
DB_PORT=9000
DB_NAME=friis
FRIIS_AUTO_CREATE_SCHEMA=true

# Auth0 access-token validation
FRIIS_AUTH0_DOMAIN=your-tenant.us.auth0.com
FRIIS_AUTH0_API_AUDIENCE=https://your-api-identifier
# Public Auth0 SPA application client ID; Swagger uses Authorization Code + PKCE.
FRIIS_AUTH0_SWAGGER_CLIENT_ID=your-public-spa-client-id
FRIIS_CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app
FRIIS_AUTH0_JWKS_CACHE_SECONDS=300
FRIIS_AUTH0_TIMEOUT_SECONDS=5

# Azure OpenAI embedding deployment. Ingestion sends extracted PDF text to this
# configured endpoint; confirm your organization's data handling approval.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-local-secret
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_LLM_DEPLOYMENT=your-chat-deployment
# Optional separate judge deployment; prefer a strong model (for example GPT-4.1
# or GPT-4o) with JSON output support. Defaults to AZURE_OPENAI_LLM_DEPLOYMENT.
AZURE_OPENAI_JUDGE_DEPLOYMENT=
# Optional vision-capable deployment; defaults to AZURE_OPENAI_LLM_DEPLOYMENT.
FRIIS_VISION_DEPLOYMENT=
FRIIS_EMBEDDING_DIMENSIONS=1536

# Langfuse observability and managed prompts. The app loads managed prompts
# when enabled and both keys are set; otherwise it uses the local catalog.
# Keep these credentials in the local, git-ignored .env file only.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Optional human-handoff email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APPLICATION_EMAIL=
SUPPORT_EMAIL=

# Enable the worker to process queued document ingestions after app startup.
FRIIS_DOCUMENTS_ROOT=Documents/
FRIIS_INGESTION_WORKER_ENABLED=false
FRIIS_QUERY_WORKER_ENABLED=false
FRIIS_INGESTION_POLL_SECONDS=2
FRIIS_DOCUMENT_CHUNK_SIZE=1200
FRIIS_DOCUMENT_CHUNK_OVERLAP=200
FRIIS_EMBEDDING_BATCH_SIZE=32
FRIIS_QUERY_WORKER_READY=false
